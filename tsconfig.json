{
  "extends": "expo/tsconfig.base",

  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@src/*": ["src/*"],
      "@assets/*": ["assets/*"],
      "@utils/*": ["utils/*"],
      "@store/*": ["store/*"],
     
    },
    
  },
  "include": ["**/*.tsx","**/*.ts","**/*.js"],
  "exclude": ["node_modules"]
}
